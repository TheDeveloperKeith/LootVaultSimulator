# Copy to .env for Docker Compose; never commit the real .env.
POSTGRES_DB=lootvault
POSTGRES_USER=lootvault
POSTGRES_PASSWORD=replace-with-a-new-local-password
# Spring reads environment variables, not this .env file automatically.
DB_URL=jdbc:postgresql://localhost:5433/lootvault
DB_USERNAME=lootvault
DB_PASSWORD=replace-with-a-new-local-password
# Optional dev testing: also activate the dev Spring profile. Never enable in production.
DEV_MODE_ENABLED=false
DEV_MODE_PHRASE=replace-with-your-private-test-phrase
